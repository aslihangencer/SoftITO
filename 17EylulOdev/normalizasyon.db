/* 
   0) NORMALİZE EDİLMEMİŞ TABLO
 */

CREATE TABLE UniversiteSpaghetti (
    OgrenciNo INT,
    OgrenciAdSoyad VARCHAR(100),
    Telefonlar VARCHAR(100),
    BolumBilgisi VARCHAR(100),
    DanismanBilgisi VARCHAR(100),
    AlinanDersler VARCHAR(255),
    DersBolumKodu VARCHAR(50)
);

