/* 
   1NF
  
   - Telefonlar ayrı satırlara ayrılır.
   - Dersler ayrı satırlara ayrılır.
   - Her hücrede tek değer bulunur.
*/

CREATE TABLE Universite_1NF (
    OgrenciNo INT,
    OgrenciAdSoyad TEXT,
    Telefon TEXT,
    BolumKodu TEXT,
    BolumAdi TEXT,
    DanismanID TEXT,
    DanismanAdi TEXT,
    DersAdi TEXT,
    DersBolumKodu TEXT,

    PRIMARY KEY (OgrenciNo, Telefon, DersAdi)
);

