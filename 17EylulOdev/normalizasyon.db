/*
   1NF (Birinci Normal Form)

   - Her hücrede tek değer bulunur.
   - Telefonlar ayrı satırlara ayrılır.
   - Dersler ayrı satırlara ayrılır.
*/

CREATE TABLE Universite_1NF (
    OgrenciNo INTEGER,
    OgrenciAdSoyad TEXT,
    Telefon TEXT,
    BolumKodu TEXT,
    BolumAdi TEXT,
    DanismanID TEXT,
    DanismanAdi TEXT,
    DersKodu TEXT,
    DersAdi TEXT,

    PRIMARY KEY (OgrenciNo, Telefon, DersKodu)
);

