---NORMALİZE VERİYİ BİRLİKTE GÖRÜNTÜLEME

SELECT
    o.OgrenciNo,
    o.OgrenciAdSoyad,
    ot.Telefon,
    b.BolumKodu,
    b.BolumAdi,
    h.DanismanID,
    h.DanismanAdi,
    d.DersKodu,
    d.DersAdi
FROM Ogrenciler AS o
LEFT JOIN OgrenciTelefonlari AS ot
    ON o.OgrenciNo = ot.OgrenciNo
INNER JOIN Bolumler AS b
    ON o.BolumKodu = b.BolumKodu
INNER JOIN BolumDanismanlari AS bd
    ON b.BolumKodu = bd.BolumKodu
INNER JOIN Hocalar AS h
    ON bd.DanismanID = h.DanismanID
INNER JOIN OgrenciDers AS od
    ON o.OgrenciNo = od.OgrenciNo
INNER JOIN Dersler AS d
    ON od.DersKodu = d.DersKodu
ORDER BY
    o.OgrenciNo,
    d.DersKodu;