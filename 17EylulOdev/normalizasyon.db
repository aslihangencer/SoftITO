/*
   2NF (İkinci Normal Form)

   - Öğrenci bilgileri ayrı tabloya alınır.
   - Telefonlar öğrenciyle ayrı ilişkilendirilir.
   - Ders bilgileri ayrı tabloya alınır.
   - Öğrenci-Ders ilişkisi ara tabloya alınır.
*/

CREATE TABLE Ogrenciler_2NF (
    OgrenciNo INTEGER PRIMARY KEY,
    OgrenciAdSoyad TEXT NOT NULL
);

CREATE TABLE OgrenciTelefonlari_2NF (
    OgrenciNo INTEGER,
    Telefon TEXT,

    PRIMARY KEY (OgrenciNo, Telefon),

    FOREIGN KEY (OgrenciNo)
        REFERENCES Ogrenciler_2NF(OgrenciNo)
);

CREATE TABLE Dersler_2NF (
    DersKodu TEXT PRIMARY KEY,
    DersAdi TEXT NOT NULL,
    DersBolumKodu TEXT NOT NULL
);

CREATE TABLE OgrenciDers_2NF (
    OgrenciNo INTEGER,
    DersKodu TEXT,

    PRIMARY KEY (OgrenciNo, DersKodu),

    FOREIGN KEY (OgrenciNo)
        REFERENCES Ogrenciler_2NF(OgrenciNo),

    FOREIGN KEY (DersKodu)
        REFERENCES Dersler_2NF(DersKodu)
);


