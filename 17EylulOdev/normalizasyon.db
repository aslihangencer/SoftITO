/* 
   3NF:
   - Bölüm bilgileri ayrı tabloya alınır.
   - Hoca bilgileri ayrı tabloya alınır.
   - Bölüm-danışman ilişkisi oluşturulur.
   - Öğrenci sadece BolumKodu tutar.
   - Ders sadece kendi bölümünün BolumKodu değerini tutar.
 */

CREATE TABLE Hocalar (
    DanismanID VARCHAR(10) PRIMARY KEY,
    DanismanAdi VARCHAR(100) NOT NULL
);

CREATE TABLE Bolumler (
    BolumKodu VARCHAR(10) PRIMARY KEY,
    BolumAdi VARCHAR(100) NOT NULL UNIQUE
);

CREATE TABLE BolumDanismanlari (
    BolumKodu VARCHAR(10) PRIMARY KEY,
    DanismanID VARCHAR(10) NOT NULL,

    FOREIGN KEY (BolumKodu)
        REFERENCES Bolumler(BolumKodu),

    FOREIGN KEY (DanismanID)
        REFERENCES Hocalar(DanismanID)
);

CREATE TABLE Ogrenciler (
    OgrenciNo INT PRIMARY KEY,
    OgrenciAdSoyad VARCHAR(100) NOT NULL,
    BolumKodu VARCHAR(10) NOT NULL,

    FOREIGN KEY (BolumKodu)
        REFERENCES Bolumler(BolumKodu)
        ON DELETE RESTRICT
);

CREATE TABLE OgrenciTelefonlari (
    TelefonID INT PRIMARY KEY AUTO_INCREMENT,
    OgrenciNo INT NOT NULL,
    Telefon TEXT NOT NULL,

    UNIQUE (OgrenciNo, Telefon),

    FOREIGN KEY (OgrenciNo)
        REFERENCES Ogrenciler(OgrenciNo)
        ON DELETE CASCADE
);

CREATE TABLE Dersler (
    DersKodu TEXT PRIMARY KEY,
    DersAdi TEXT NOT NULL,
    BolumKodu TEXT NOT NULL,

    FOREIGN KEY (BolumKodu)
        REFERENCES Bolumler(BolumKodu)
        ON DELETE RESTRICT
);

CREATE TABLE OgrenciDers (
    OgrenciNo INT,
    DersKodu TEXT,

    PRIMARY KEY (OgrenciNo, DersKodu),

    FOREIGN KEY (OgrenciNo)
        REFERENCES Ogrenciler(OgrenciNo)
        ON DELETE CASCADE,

    FOREIGN KEY (DersKodu)
        REFERENCES Dersler(DersKodu)
        ON DELETE RESTRICT
);

